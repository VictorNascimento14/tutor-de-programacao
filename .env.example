# ---------------------------------------------------------------------------
# Tutor de Programacao - variaveis de ambiente
# Copie este arquivo para `.env` e ajuste os valores.
# O sistema funciona 100% sem nenhuma destas variaveis (modo motor local).
# ---------------------------------------------------------------------------

# Porta do servidor HTTP
PORT=3000

# Host de bind (use 0.0.0.0 para expor na rede local)
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# OpenRouter - Provedor Hibrido (JEV Decisoes + LLM Principal)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MAIN_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_JEV_MODEL=typesafe/jev-1.13
OPENROUTER_BASE_URL=https://openrouter.ai/api

# ---------------------------------------------------------------------------
# IA opcional legado (Claude). Sem chave, o sistema usa o motor local ou OpenRouter.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=3000

# Limite de requisicoes por janela (por IP)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Tamanho maximo do corpo da requisicao em bytes (padrao 1 MB)
MAX_BODY_BYTES=1048576
